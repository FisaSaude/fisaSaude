  name: Bloquear Dia
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/agendamentos/bloquear-dia
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "usuarioId": {{usuarioId}},
    "data": "2026-06-20"
  }
}

docs {
  ## Bloquear Dia Inteiro

  Cria um bloqueio de agenda para um dia inteiro para um profissional, impedindo novos agendamentos nessa data.

  O agendamento criado terá status `BLOQUEADO`.

  **Campos obrigatórios:**
  - `usuarioId` — ID do profissional (positivo)
  - `data` — data a ser bloqueada (`yyyy-MM-dd`)

  **Respostas:** 201 Bloqueado | 400 Dados inválidos | 404 Usuário não encontrado
}

