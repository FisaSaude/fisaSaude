meta {
  name: Listar Slots Disponíveis
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/agendamentos/slots-disponiveis?usuarioId=2&data=2026-06-10&duracaoMinutos=60
  body: none
  auth: bearer
}

params:query {
  usuarioId: 2
  data: 2026-06-10
