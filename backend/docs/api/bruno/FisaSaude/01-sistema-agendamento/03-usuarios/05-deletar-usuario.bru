meta {
  name: Deletar Usuário
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/usuarios/{{usuarioId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  ## Deletar Usuário

  Remove um usuário pelo identificador.

  **Respostas:** 204 Removido | 404 Não encontrado | 401 Não autenticado
}

