meta {
  name: Resposta WhatsApp Inbound
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agendamentos/{{agendamentoId}}/resposta-whatsapp
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{internalApiKey}}
}

body:json {
